#assignment of day3

#model1
X1 = df[["weekly_self_study_hours"]]
Y1 = df["total_score"]

#model2
X2 = df[["weekly_self_study_hours","attendance_percentage"]]
Y2 = df["total_score"]

#model3
X3 = df[["weekly_self_study_hours","attendance_percentage", "class_participation"]]
Y3 = df["total_score"]

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error
X1_train, X1_test, Y1_train, Y1_test = train_test_split(X1, Y1, test_size=0.2, random_state=42)
model1 = LinearRegression()
model1.fit(X1_train, Y1_train)
Y1_pred = model1.predict(X1_test)
r2_1 = r2_score(Y1_test, Y1_pred)
mae_1 = mean_absolute_error(Y1_test, Y1_pred)
rmse_1 = mean_squared_error(Y1_test, Y1_pred) ** 0.5
print("MODEL 1")
print("Coefficient:", model1.coef_)
print("Intercept:", model1.intercept_)
print("R²:", r2_1)
print("MAE:", mae_1)
print("RMSE:", rmse_1)

